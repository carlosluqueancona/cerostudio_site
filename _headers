# Cloudflare Pages — Cache + Security Headers

# ── Security headers (all routes) ────────────────────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# ── Content-Security-Policy por sección ──────────────────────────────────────

# Sitio principal y páginas generales
# NOTA: este CSP hoy NO llega al navegador en / (la respuesta la genera
# functions/index.js y _headers no aplica a responses de Functions — bug
# preexistente detectado 2026-07-04, pendiente de resolver poniendo los
# headers desde el middleware). Se mantiene actualizado para cuando aplique.
/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://cdnjs.cloudflare.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://analytics.google.com; frame-src https://challenges.cloudflare.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://intake.cerostudio.ai

# Blog público
/blog/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'

# Admin panel — más permisivo para permitir uploads a R2
/blog/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://cerostudio.ai https://*.r2.dev; object-src 'none'; frame-ancestors 'none'; base-uri 'self'

# Portal cliente
/proyecto/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://intake.cerostudio.ai; object-src 'none'; frame-ancestors 'none'; base-uri 'self'

# Formulario de intake / brief
/brief/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://intake.cerostudio.ai; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://intake.cerostudio.ai

# Admin de briefs — no indexar
/brief/admin*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# ── Cache Headers ─────────────────────────────────────────────────────────────

# Images: 1 year immutable (content never changes for a given filename)
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Blog CSS + JS: 1 week (may update)
/blog/blog.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/blog/blog.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Shared components (navbar, footer, cursor, cookie consent) — short cache
# These inject layout HTML on every page. A long cache means content/footer
# updates take hours to propagate. 5 min hard cache + 1 day SWR keeps it
# fast on repeat hits but updates roll out quickly.
/components/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Shared CSS — same logic
/css/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Page JS (home.js, hero-pulse, etc.) — todas las referencias llevan ?v=,
# así que puede cachearse fuerte; el bump de versión invalida.
/js/*
  Cache-Control: public, max-age=31536000, immutable

# SVG/font assets: 1 year
/images/svg/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages: no cache (always fresh, JS/CSS embedded)
/
  Cache-Control: no-cache

/blog/
  Cache-Control: no-cache

/blog/*
  Cache-Control: no-cache

# Admin panel: no cache, no indexing
/admin/
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
