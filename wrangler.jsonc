{
	"name": "cerostudio-site",
	"compatibility_date": "2026-04-13",
	"pages_build_output_dir": ".",
	"vars": {
		// Meta Pixel "Cero Studio" (dataset en el business Cero Studio Agencia).
		// El token va como Secret en el dashboard (META_CAPI_TOKEN), nunca aquí.
		"META_PIXEL_ID": "2460013067759593"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cerostudio-blog",
			"database_id": "1a7a6532-2113-41b2-b19d-93fc46e21338"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "cerostudio-blog-images"
		}
	]
}